# Proton Flow - Configurações do Backend Speech-to-Text (faster-whisper)
STT_ENABLED=true
STT_PROVIDER=faster_whisper

# Tamanho do modelo Whisper: 'small' (recomendado para CPU com alta fidelidade pt-BR), 'base' (mais rápido) ou 'medium' (maior precisão / GPU)
STT_MODEL_SIZE=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=pt
STT_TASK=transcribe
STT_BEAM_SIZE=5
STT_TEMPERATURE=0.0

# Voice Activity Detection (Silero VAD) com speech padding estendido para preservar sílabas iniciais e finais
STT_VAD_FILTER=true
STT_VAD_SPEECH_PAD_MS=600
STT_VAD_MIN_SPEECH_DURATION_MS=250
STT_VAD_MIN_SILENCE_DURATION_MS=350

# Tamanho do chunk e controle de fluxo (8s recomendado para contexto acústico contínuo)
STT_CHUNK_SECONDS=8
STT_MAX_CONCURRENT_TRANSCRIBES=3

# Diretório de cache persistente do modelo (se vazio, utiliza ~/.cache/huggingface/hub)
STT_MODEL_CACHE_DIR=
