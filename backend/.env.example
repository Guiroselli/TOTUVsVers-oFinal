# Proton Flow - Configurações do Backend Speech-to-Text (faster-whisper)
STT_ENABLED=true
STT_PROVIDER=faster_whisper
STT_MODEL_SIZE=base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=pt
STT_BEAM_SIZE=1
STT_VAD_FILTER=true
STT_CHUNK_SECONDS=4
STT_MAX_CONCURRENT_TRANSCRIBES=3
# Diretório de cache persistente do modelo (opcional; se vazio, utiliza ~/.cache/huggingface/hub)
STT_MODEL_CACHE_DIR=
