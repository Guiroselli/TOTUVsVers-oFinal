# Proton Flow - Configurações do Backend Speech-to-Text Portátil (faster-whisper)
STT_ENABLED=true
STT_PROVIDER=faster_whisper
STT_ENGINE=faster-whisper
STT_MODEL_SIZE=small
STT_LANGUAGE=pt
STT_TASK=transcribe
STT_DEVICE=auto
STT_COMPUTE_TYPE=auto
STT_MODEL_CACHE_DIR=./models
STT_VAD_FILTER=true
STT_VAD_MIN_SILENCE_DURATION_MS=350
STT_VAD_SPEECH_PAD_MS=500
STT_VAD_MIN_SPEECH_DURATION_MS=250
STT_CHUNK_SECONDS=6
STT_OVERLAP_SECONDS=1
STT_MAX_WORKERS=auto
STT_MAX_PENDING_CHUNKS=2
STT_BEAM_SIZE=3
STT_BEST_OF=1
STT_TEMPERATURE=0
STT_CONDITION_ON_PREVIOUS_TEXT=false
STT_WORD_TIMESTAMPS=true
STT_FINAL_REPROCESS_ENABLED=false
STT_FINAL_MODEL_SIZE=small
STT_FINAL_BEAM_SIZE=5
STT_FINAL_CHUNK_SECONDS=30

# Voice Activity Detection (Silero VAD) calibrado para fala natural em PT-BR
STT_VAD_MIN_SILENCE_DURATION_MS=350
STT_VAD_SPEECH_PAD_MS=500
STT_VAD_MIN_SPEECH_DURATION_MS=250

# Flag geral de habilitação
STT_ENABLED=true

# Camada DPO/RLAIF Híbrida Experimental (Preference Reranker & Adaptador Opcional)
DPO_ENABLED=false
DPO_MODE=reranker
DPO_DATASET_PATH=artifacts/dpo_hybrid/train.jsonl
DPO_VALIDATION_PATH=artifacts/dpo_hybrid/validation_ai.jsonl
DPO_HUMAN_TEST_PATH=artifacts/dpo_hybrid/test_human.jsonl
DPO_MIN_AI_AGREEMENT=0.75
DPO_MIN_EVALUATORS=4
DPO_REQUIRE_EVIDENCE=true
DPO_MAX_LATENCY_MS=1500
DPO_FALLBACK_TO_BASE=true
DPO_ADAPTER_PATH=models/dpo_experimental
